{
	"name": "alas-stable",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "pnpm run typecheck && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts",
		"lint": "oxlint --type-aware --max-warnings 0 && stylelint \"src/**/*.css\" && html-validate index.html \"src/**/*.html\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test",
		"check:browser": "node scripts/check-browser.ts"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"lucide": "^1.41.0",
		"three": "^0.180.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^24.13.3",
		"@types/three": "^0.180.0",
		"html-validate": "^11.14.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "^3.9.6",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "7.0.2",
		"vite": "^7.3.6"
	},
	"engines": {
		"node": "^22.18.0 || >=24.0.0"
	},
	"packageManager": "pnpm@10.33.4"
}
